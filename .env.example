# ==============================================================================
# AI-Powered Enterprise Query Reformulation Engine - Environment Configuration
# ==============================================================================

# Supabase Project Credentials (from Supabase Dashboard -> Project Settings -> API)
# Project Name: Query_Reformulation_Engine
SUPABASE_URL=https://your-project-ref.supabase.co

# Service-Role Key (Required for backend ingestion pipeline; NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Supabase Anon / Public Key
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Embedding Configuration (Locked In: BAAI/bge-small-en-v1.5, 384 dimensions)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
UPSERT_BATCH_SIZE=50
# Embed chunks as "title / section / text" (Phase 5). Set 0 to embed bare chunk text.
EMBEDDING_CONTEXTUAL=1

# Data Paths
CHUNKS_PATH=Data/chunks/chunks.jsonl
VALIDATED_DOCS_PATH=Data/validated/validated_documents.json

# Execution Settings
HF_LOCAL_FILES_ONLY=1
DRY_RUN=0

# LLM for query reformulation (any OpenAI-compatible /chat/completions endpoint)
LLM_PROVIDER=openai-compatible
LLM_MODEL=your-model-name
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://your-provider.example.com/v1/chat/completions
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Optional cross-encoder reranker (off by default)
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_BATCH_SIZE=32
